# Local development: use DATABASE_URL or all of the DB_* variables below.
# On Render, set DATABASE_URL to the PostgreSQL service's Internal Database URL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms
DB_USER=postgres
DB_PASSWORD=

# Comma-separated browser origins. Leave empty when the bundled frontend is
# served by this FastAPI service.
CORS_ORIGINS=
